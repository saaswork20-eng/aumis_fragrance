# Neon Serverless PostgreSQL Connection String (Pooled for serverless queries)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct PostgreSQL Connection String (Used for migrations)
DIRECT_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js Secret (Generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-character-secret"
AUTH_SECRET="change-this-to-a-secure-random-32-character-secret"

# Public Canonical URL
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Credentials (Optional Overrides for Seeding)
DEMO_ADMIN_PASSWORD="DemoAdminPassword123!"
DEMO_SELLER_PASSWORD="DemoSellerPassword123!"
DEMO_BUYER_PASSWORD="DemoBuyerPassword123!"
